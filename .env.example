# ============================================================
# Super Network Administrator - Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ------------------------------------------------------------
# NextAuth.js
# ------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------
# Azure AD / Entra ID App Registration
# ------------------------------------------------------------
# Create an App Registration in portal.azure.com / entra.microsoft.com:
#   1. Go to Entra ID > App registrations > New registration
#   2. Name: "Super Network Administrator"
#   3. Supported account types: Accounts in this organizational directory only
#   4. Redirect URI (Web): http://localhost:3000/api/auth/callback/azure-ad
#      (For production: https://yourdomain.com/api/auth/callback/azure-ad)
#   5. After creation, note the Application (client) ID and Directory (tenant) ID
#   6. Under "Certificates & secrets", create a new client secret
#   7. Under "API permissions", add Microsoft Graph delegated permissions:
#      - User.Read
#      - User.ReadWrite.All
#      - Directory.ReadWrite.All
#      - Group.ReadWrite.All
#      - Device.Read.All
#      - SecurityEvents.Read.All
#      - AuditLog.Read.All
#      - Organization.Read.All
#      - Mail.ReadBasic.All
#      - DeviceManagementManagedDevices.Read.All
#      - DeviceManagementManagedDevices.ReadWrite.All
#   8. Grant admin consent for your organization
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Development (SQLite - no setup required):
DATABASE_URL="file:./dev.db"

# Production (Azure SQL - uncomment and fill in):
# DATABASE_URL="sqlserver://your-server.database.windows.net:1433;database=supernetadmin;user=adminuser;password=YourPassword;encrypt=true"

# Production (PostgreSQL on Azure - uncomment and fill in):
# DATABASE_URL="postgresql://username:password@your-server.postgres.database.azure.com:5432/supernetadmin?sslmode=require"

# ------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------
# Set to "true" after initial setup is complete (auto-set by setup wizard)
SETUP_COMPLETE=false

# Application name shown in the UI
APP_NAME="Super Network Administrator"
